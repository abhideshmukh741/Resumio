# Database Connection (PostgreSQL / Supabase / SQLite)
DATABASE_URL=postgresql+psycopg2://postgres:your_password@db.your_supabase_id.supabase.co:5432/postgres

# Groq LLM API Key & Model Configuration for Agno Agents
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
MODEL_TEMPERATURE=0.2

# Application Security
SECRET_KEY=your_secure_jwt_secret_key_here
